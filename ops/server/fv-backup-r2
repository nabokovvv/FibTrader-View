#!/usr/bin/env bash
# Daily (fv-backup-r2.timer): copy the newest user-data backup to Cloudflare R2.
#   daily/   kept 5 days;  monthly/ (taken on the 1st) kept 35 days — everything older is deleted.
# Credentials: /etc/fibtrader/r2.env (R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET).
set -euo pipefail
[ -f /etc/fibtrader/r2.env ] || { logger -t fv-backup "no /etc/fibtrader/r2.env: skipped"; exit 0; }
. /etc/fibtrader/r2.env
export RCLONE_CONFIG_R2_TYPE=s3 RCLONE_CONFIG_R2_PROVIDER=Cloudflare RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true \
  RCLONE_CONFIG_R2_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID" RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY" \
  RCLONE_CONFIG_R2_ENDPOINT="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com"
fail() { fv-alert "backup failed" "$1"; exit 1; }
src=$(ls -1t /home/ubuntu/fibtrader-view/data/backups/app-*.sqlite 2>/dev/null | head -1) || true
[ -n "$src" ] || fail "no local backup file found"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
name="$(basename "$src" .sqlite)"
gzip -c "$src" > "$tmp/$name.sqlite.gz"
rclone copyto "$tmp/$name.sqlite.gz" "r2:$R2_BUCKET/daily/$name.sqlite.gz" || fail "upload to R2 failed"
[ "$(date -u +%d)" = "01" ] && { rclone copyto "$tmp/$name.sqlite.gz" "r2:$R2_BUCKET/monthly/$name.sqlite.gz" || fail "monthly upload failed"; }
rclone delete --min-age 5d "r2:$R2_BUCKET/daily" || fail "pruning daily backups failed"
rclone delete --min-age 35d "r2:$R2_BUCKET/monthly" || true
logger -t fv-backup "uploaded $name to R2"
