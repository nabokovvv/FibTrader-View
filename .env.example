# Copy to .env (never commit .env). Alpaca free-plan market-data keys enable the "us" market.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# sip = consolidated history (15-min lag), iex = real-time but IEX-only volume. Keep "sip": the app
# automatically uses iex for the live tail.
ALPACA_FEED=sip
# LV_HOST=0.0.0.0
# LV_PORT=8100
# LV_TIMEZONE=Europe/Nicosia
# LV_DATA_DIR=/absolute/path/if/not/project/data
# Markets to serve (empty = all configured). Public instance: bybit,bybit-spot,hl (hl = Hyperliquid perpetuals:
# crypto, stocks, indices, commodities, FX). LV_HL_ARCHIVE=0 turns off its 1h/4h/1D archive and OI recorder.
# LV_MARKETS=
# Auth: none (private, single local user) | supabase (public)
# LV_AUTH=none
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
